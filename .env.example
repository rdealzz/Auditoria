# ── Supabase (opcional) ─────────────────────────────────────────────
# Sem estas variáveis o sistema roda 100% local (dados no navegador).
# Com elas, autenticação, banco e storage passam a usar o Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── OpenAI (opcional) ───────────────────────────────────────────────
# Sem a chave, o Assistente usa o motor local (regras + normas embarcadas).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Bancos de imagens (opcional, para `npm run imagens`) ────────────
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
